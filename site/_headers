# En-têtes HTTP — lus par Netlify et Cloudflare Pages (Vercel : voir vercel.json à la racine)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; script-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Page de suivi personnel : tenue hors des moteurs de recherche.
# (La balise <meta name="robots"> dans la page fait le même travail, par sécurité.)
/apprentissage/*
  X-Robots-Tag: noindex, nofollow, noarchive
